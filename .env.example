# Copy to .env and fill in. The app runs fully without any of these — it just
# runs on one phone instead of on a board every phone in the room shares.

# ── The shared board ─────────────────────────────────────────────────────────
# Supabase → Project Settings → API. Every phone holds these two.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Supabase → Project Settings → Database → Connection string → URI.
# Only `npm run db:reset` reads this and it never reaches the app bundle. It
# carries the database password, so it belongs in .env and nowhere else.
SUPABASE_DB_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── The assistant ────────────────────────────────────────────────────────────
# Either key works. Groq is tried first because it answers in under a second,
# and during an event that is the difference between a suggestion being read
# and being given up on.
# console.groq.com/keys
EXPO_PUBLIC_GROQ_KEY=gsk_...
# openrouter.ai/keys — free models
EXPO_PUBLIC_OPENROUTER_KEY=sk-or-v1-...

# Anything prefixed EXPO_PUBLIC_ is inlined into the client bundle and readable
# by anyone holding the app. Fine for a prototype; proxy them through a server
# before distributing anything.
