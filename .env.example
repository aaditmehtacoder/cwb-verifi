# Copy to .env and fill in. All optional — the app runs fully without them.

# openrouter.ai/keys — powers the admin's AI suggestion (free models only)
EXPO_PUBLIC_OPENROUTER_KEY=sk-or-v1-...

# Supabase → Project Settings → API. Enables the shared live board across phones.
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
